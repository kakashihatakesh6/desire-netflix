# -----------------------------------------------
# Copy this file to .env.local for local dev
# Set ALL of these in Vercel > Settings > Environment Variables
# -----------------------------------------------

# Required: Your Vercel deployment URL (no trailing slash)
NEXTAUTH_URL=https://desire-netflix-27si.vercel.app

# Required: Random secret for NextAuth session encryption
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=

# Required: Secret used for JWT signing
NEXTAUTH_JWT_SECRET=

# Required: MongoDB Atlas connection string
DATABASE_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority

# GitHub OAuth (https://github.com/settings/developers)
# Callback URL to add: https://desire-netflix-27si.vercel.app/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# Google OAuth (https://console.cloud.google.com)
# Callback URL to add: https://desire-netflix-27si.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
